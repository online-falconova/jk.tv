<?xml version="1.0" encoding="utf-8"?>
<!-- Classic glass, no hue: focus and selection read as brightness changes on frosted white, never a colour. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#40FFFFFF" android:endColor="#2EFFFFFF" />
            <corners android:radius="14dp" />
            <stroke android:width="1.5dp" android:color="#80FFFFFF" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#33FFFFFF" android:endColor="#20FFFFFF" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#59FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#1FFFFFFF" android:endColor="#0FFFFFFF" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#1FFFFFFF" />
        </shape>
    </item>
</selector>
