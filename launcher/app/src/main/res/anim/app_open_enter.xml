<?xml version="1.0" encoding="utf-8"?>
<!-- The opening app zooms up into place from behind the tile and fades in. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/decelerate_cubic"
    android:duration="260">
    <alpha android:fromAlpha="0.35" android:toAlpha="1.0" />
    <scale android:fromXScale="0.85" android:toXScale="1.0"
        android:fromYScale="0.85" android:toYScale="1.0"
        android:pivotX="50%" android:pivotY="50%" />
</set>
